# Environment Configuration Template for censor-tg-bot
# Copy this file to .env and fill in your actual values
# Loading order (later wins): YAML file (CONFIG_PATH) < .env file < process environment
# Only TELEGRAM__TOKEN and BOT__ADMIN_ID are required; optional variables are
# commented out — uncomment a line to override the built-in default (an
# uncommented value here also takes precedence over the same key in YAML).

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# Bot Token
# Purpose: Authenticates the bot with the Telegram Bot API
# Format: <bot_id>:<secret> (issued by @BotFather)
# Example: 123456789:AAE-example-token
TELEGRAM__TOKEN=123456789:your-bot-token

# Administrator User ID
# Purpose: Receives moderation notifications and is never moderated itself
# Format: Integer (Telegram user ID)
# Example: 123456789
BOT__ADMIN_ID=123456789

# =============================================================================
# TELEGRAM CONFIGURATION
# =============================================================================

# API Request Timeout
# Purpose: HTTP client timeout for Telegram Bot API requests (long-poll interval is fixed at 60s)
# Format: Duration (e.g. 30s, 5m, 1h)
# Default: 60s (the effective HTTP timeout is clamped to a 70s minimum so it outlives the 60s long poll)
# Example: 60s
# TELEGRAM__TIMEOUT=60s

# API Proxy
# Purpose: Route Telegram API traffic through a SOCKS5 proxy
# Format: socks5://[user:pass@]host:port
# Example: socks5://user:pass@127.0.0.1:1080
# TELEGRAM__PROXY_URL=socks5://user:pass@127.0.0.1:1080

# =============================================================================
# BOT CONFIGURATION
# =============================================================================

# Ban Threshold
# Purpose: Number of violations after which a user is automatically banned
# Format: Integer
# Default: 3
# Example: 3
# BOT__BAN_THRESHOLD=3

# Media Download Size Limit
# Purpose: Maximum size of a downloaded photo; larger files are skipped as moderation input
# Format: Integer (bytes)
# Default: 10485760 (10 MiB)
# Example: 10485760
# BOT__MEDIA__MAX_BYTES=10485760

# Media Download Timeout
# Purpose: Deadline for downloading a photo's content; the Telegram file metadata lookup uses telegram.timeout
# Format: Duration (e.g. 30s, 5m)
# Default: 5s
# Example: 5s
# BOT__MEDIA__TIMEOUT=5s

# =============================================================================
# CENSOR CONFIGURATION
# =============================================================================

# Execution Strategy
# Purpose: How plugins are executed when evaluating a message
# Format: sequential | parallel
# Default: sequential
# Example: sequential
# CENSOR__STRATEGY=sequential

# Evaluation Timeout
# Purpose: Time budget for evaluating one message across all plugins
# Format: Duration (e.g. 10s, 30s, 1m)
# Default: 30s
# Example: 30s
# CENSOR__TIMEOUT=30s

# Enabled-Only Mode
# Purpose: Run only plugins marked enabled: true (plugins live in YAML config)
# Format: Boolean (true|false)
# Default: true
# Example: true
# CENSOR__ENABLED_ONLY=true

# Error Action
# Purpose: What to do with a message when plugin evaluation fails
# Format: block | allow
# Default: block
# Example: block
# CENSOR__ERROR_ACTION=block

# Skip Action
# Purpose: What to do with a message when every plugin skips it
# Format: block | allow
# Default: allow
# Example: allow
# CENSOR__SKIP_ACTION=allow

# Plugin settings normally live in YAML (CONFIG_PATH); secrets can be passed as
# environment variables instead of being written into a config file:
# Purpose: API key for the LLM content-filter plugin
# Format: string (provider API key)
# Example: sk-your-api-key
# CENSOR__PLUGINS__LLM__CONFIG__API_KEY=sk-your-api-key

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Storage URL
# Purpose: State backend for violation counters and duplicate detection
# Format: memory://<name>?ttl=<duration> (only the memory scheme is supported)
# Default: memory://storage?ttl=5m
# Example: memory://storage?ttl=5m
# STORAGE__URL=memory://storage?ttl=5m

# =============================================================================
# HTTP / METRICS CONFIGURATION
# =============================================================================

# Metrics Address
# Purpose: Bind address of the HTTP server exposing /metrics (Prometheus)
# Format: host:port
# Default: 127.0.0.1:3000
# Example: 127.0.0.1:3000
# HTTP__ADDRESS=127.0.0.1:3000

# Trusted Proxies
# Purpose: IPs treated as reverse proxies when resolving the real client address
# Format: single IP address or JSON array of IP addresses (comma-separated lists are not split)
# Default: none (proxy header is ignored)
# Example: ["127.0.0.1", "10.0.0.1"]
# HTTP__PROXIES=["127.0.0.1", "10.0.0.1"]

# Proxy Header
# Purpose: HTTP header carrying the original client IP behind a trusted proxy
# Format: HTTP header name
# Default: X-Forwarded-For
# Example: X-Forwarded-For
# HTTP__PROXY_HEADER=X-Forwarded-For

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# YAML Configuration File
# Purpose: Load additional configuration (plugins, per-key overrides) from a YAML file
# Format: File path
# Note: must be set in the process environment before startup; the path is read
# before .env is loaded, so a value set only in this file has no effect
# Example: export CONFIG_PATH=configs/config.yml

# Debug Mode
# Purpose: Enable debug-level logging and Telegram API request logging
# Format: any non-empty value enables debug mode; leave unset or empty to disable
# Default: false (disabled)
# Example: true
# DEBUG=true
