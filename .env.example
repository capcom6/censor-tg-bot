TELEGRAM__TOKEN=xxx:yyyyy    # bot token from @BotFather
TELEGRAM__ADMIN_ID=123456789 # admin id
TELEGRAM__PROXY_URL=socks5://user:pass@127.0.0.1:1080 # optional SOCKS5 proxy
TELEGRAM__TIMEOUT=30s        # timeout for Telegram API requests
CENSOR__BLACKLIST='x,y,z'    # list of banned words, separated by comma
BOT__MEDIA__MAX_BYTES=5242880 # largest Telegram photo (bytes) the bot downloads; larger variants are skipped, never blocked
BOT__MEDIA__TIMEOUT=5s        # deadline for one photo download; per-message worst case is this plus CENSOR__TIMEOUT
